# Valores locais fictícios. Copie para .env e substitua antes de usar.
# Nunca commite o .env real. Em produção, configure estas variáveis no orquestrador (Coolify, etc.).

# --- Postgres (compose.yaml) ---------------------------------------------------
POSTGRES_DB=agenda
POSTGRES_USER=agenda
# Use só letras/números/-/_ ou percent-encode na DATABASE_URL.
POSTGRES_PASSWORD=local-example-change-me
# Porta publicada em 127.0.0.1 no host.
POSTGRES_PORT=5432

# --- Banco (lido pelo app, drizzle-kit, migrate.cjs e testes) -------------------
DATABASE_URL=postgresql://agenda:local-example-change-me@localhost:5432/agenda

# --- Autenticação (Better Auth) -------------------------------------------------
# URL pública do app (origem confiável dos links mágicos). Em produção: https://seu-dominio
BETTER_AUTH_URL=http://localhost:3000
# Gere um valor exclusivo: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-this-with-a-random-secret-at-least-32-characters

# --- Email (links de acesso por SMTP) -------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Usuário e senha devem ser configurados juntos (ou ambos vazios).
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Agenda <acesso@example.com>

# --- Pagamento ------------------------------------------------------------------
# Simulação local somente: o provedor fake é recusado quando NODE_ENV=production
# (a imagem Docker roda em produção, então a cobrança responde 503 até existir um gateway real).
PAYMENT_PROVIDER=fake
FAKE_WEBHOOK_SECRET=replace-this-with-another-random-secret-at-least-32-characters

# --- Servidor (imagem Docker / compose --profile app) ---------------------------
# Porta publicada em 127.0.0.1 pelo serviço "app" do compose.
APP_PORT=3000
# Dentro da imagem já valem NODE_ENV=production, PORT=3000 e HOSTNAME=0.0.0.0.
# MIGRATIONS_DIR=db/migrations   # opcional, usado por migrate.cjs

# Não são mais necessárias com o app único (mesma origem para páginas e /api):
# NEXT_PUBLIC_BACKEND_URL, BACKEND_INTERNAL_URL, NEXT_PUBLIC_DASHBOARD_URL
