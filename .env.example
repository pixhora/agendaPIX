# Valores locais fictícios. Copie para .env e substitua antes de usar.
POSTGRES_DB=agenda
POSTGRES_USER=agenda
POSTGRES_PASSWORD=local-example-change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://agenda:local-example-change-me@localhost:5432/agenda

BETTER_AUTH_URL=http://localhost:3000
# Gere um valor exclusivo: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-this-with-a-random-secret-at-least-32-characters

# Configure um servidor SMTP para enviar links de acesso.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Agenda <acesso@example.com>

# Simulação local somente; nunca habilitar em produção.
PAYMENT_PROVIDER=fake
FAKE_WEBHOOK_SECRET=replace-this-with-another-random-secret-at-least-32-characters

# Opcional para desenvolvimento. Gere com `openssl rand -hex 32` e configure por canal seguro.
# Sem este segredo, cadastro de chave Pix fica indisponível; nunca use uma chave compartilhada em produção.
PIX_KEY_ENCRYPTION_KEY=

# Antiabuso das reservas públicas (veja README > Antiabuso). Valores vazios usam o padrão indicado.
# Ative somente atrás de proxy que sobrescreve o header de IP e bloqueia acesso direto ao Next.
BOOKING_TRUST_PROXY=false
# x-real-ip (padrão) ou x-forwarded-for (regra rightmost-trusted).
BOOKING_CLIENT_IP_HEADER=x-real-ip
# Quantos proxies confiáveis anexam X-Forwarded-For na frente do Next (1-10). Só com x-forwarded-for.
BOOKING_TRUSTED_PROXY_HOPS=1
# Tentativas por minuto: por cliente e teto total por negócio (teto >= cliente).
BOOKING_RATE_LIMIT_PER_CLIENT=10
BOOKING_RATE_LIMIT_PER_BUSINESS=120
# Minutos que um horário fica reservado aguardando o Pix (2-30).
BOOKING_HOLD_MINUTES=10
# Reservas pendentes (não pagas, não vencidas) simultâneas por negócio.
BOOKING_MAX_PENDING_PER_CLIENT=3
BOOKING_MAX_PENDING_PER_PHONE=2
BOOKING_MAX_PENDING_PER_BUSINESS=50

# Timeout das chamadas ao gateway (ms) ao criar/consultar/cancelar cobrança.
PAYMENT_PROVIDER_TIMEOUT_MS=8000
# Reconciliador (pnpm reconcile): intervalo do loop, idade mínima de "creating" preso, lote.
RECONCILE_INTERVAL_SECONDS=60
RECONCILE_STUCK_SECONDS=60
RECONCILE_BATCH_SIZE=50
