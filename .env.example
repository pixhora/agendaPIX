# Valores locais fictícios. Copie para .env e substitua antes de usar.
# Nunca commite o .env real. Em produção, configure estas variáveis no orquestrador (Coolify, etc.).

# --- Postgres (compose.yaml) ---------------------------------------------------
POSTGRES_DB=agenda
POSTGRES_USER=agenda
# Use só letras/números/-/_ ou percent-encode na DATABASE_URL.
POSTGRES_PASSWORD=local-example-change-me
# Porta publicada em 127.0.0.1 no host.
POSTGRES_PORT=5432

# --- Banco (lido pelo app, drizzle-kit, migrate.cjs e testes) -------------------
DATABASE_URL=postgresql://agenda:local-example-change-me@localhost:5432/agenda
# Vercel + Neon: DATABASE_URL = URL com pooler (host "-pooler", sslmode=require) para o app;
# DATABASE_URL_UNPOOLED = conexão direta, usada por migrations e pela rota /api/cron/reconcile
# (advisory lock de sessão não funciona atrás do pooler). A integração Neon ↔ Vercel cria as duas.
DATABASE_URL_UNPOOLED=

# --- Autenticação (Better Auth) -------------------------------------------------
# URL pública do app (origem confiável dos links mágicos). Em produção: https://seu-dominio
BETTER_AUTH_URL=http://localhost:3000
# Origem canônica (metadataBase, sitemap, robots). Host final, depois do redirect.
NEXT_PUBLIC_SITE_URL=https://www.agendapix.dev.br
# Gere um valor exclusivo: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-this-with-a-random-secret-at-least-32-characters
# Decisão de produto ainda pendente. false (padrão) permite vários negócios por dono.
# Só a string true faz o commit do rascunho responder 409 already_has_business com publicPath.
# POST /api/onboarding (contrato atual) não consulta esta flag.
ONE_BUSINESS_PER_OWNER=false
# Fora de produção e do preview da Vercel, vazio usa BETTER_AUTH_SECRET.
# Em Production e em Preview é obrigatório, com valores diferentes: openssl rand -base64 32,
# pelo menos 32 caracteres, sem o prefixo de exemplo e diferente de BETTER_AUTH_SECRET.
# O boot e o next build (VERCEL_ENV=production e VERCEL_ENV=preview) recusam subir sem isso.
BOOKING_ACCESS_SECRET=
# Só na rotação, para retomar um Pix de link de horário começado com o segredo antigo.
# Pelo menos 32 caracteres. Abaixo disso não entra. Pode ser igual a BETTER_AUTH_SECRET.
# Se for igual a BOOKING_ACCESS_SECRET, o boot avisa, sem imprimir o valor.
# Apague depois que esses pagamentos passarem.
BOOKING_ACCESS_SECRET_PREVIOUS=
RATE_LIMIT_SECRET=

# --- Email (links de acesso por SMTP) -------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Usuário e senha devem ser configurados juntos (ou ambos vazios).
SMTP_USER=
SMTP_PASSWORD=
# Em NODE_ENV=production o boot recusa o domínio example.com neste campo.
SMTP_FROM=AgendaPix <acesso@example.com>
# Opcional. Vazio omite o Reply-To. Em produção o boot recusa example.com aqui também, sem repetir o endereço.
SMTP_REPLY_TO=

# --- Pagamento ------------------------------------------------------------------
# fake (padrão fora de produção) | mercadopago. Em NODE_ENV=production o fake é recusado:
# configure PAYMENT_PROVIDER=mercadopago + MERCADOPAGO_ACCESS_TOKEN + MERCADOPAGO_WEBHOOK_SECRET (senão 503).
PAYMENT_PROVIDER=fake
FAKE_WEBHOOK_SECRET=replace-this-with-another-random-secret-at-least-32-characters

# Mercado Pago Payments API (POST /v1/payments). Hoje este token da plataforma cria o Pix.
# O PR de OAuth passa o token do dono em resolveMpAccessToken. Nunca exponha no front.
MERCADOPAGO_ACCESS_TOKEN=
# sandbox = credenciais de teste | production = credenciais de produção (API URL é a mesma).
MERCADOPAGO_ENV=sandbox
# Opcional: sobrescreve a URL base (padrão https://api.mercadopago.com).
MERCADOPAGO_BASE_URL=
# Secret gerado em Webhooks → Configurar notificações (HMAC-SHA256 do manifesto id;request-id;ts).
# Cadastre os eventos payment e mp-connect em /api/webhooks/payments/mercadopago.
# Não é o client_secret do OAuth. O ts fora de ±300s é recusado.
# date_of_expiration no Mercado Pago = hold + 2 min. O hold público continua BOOKING_HOLD_MINUTES.
MERCADOPAGO_WEBHOOK_SECRET=replace-this-with-the-mercadopago-webhook-secret-32c
# Opcional. Vazio usa BETTER_AUTH_URL + /api/webhooks/payments/mercadopago.
MERCADOPAGO_NOTIFICATION_URL=
# true envia o CPF ao Mercado Pago. Padrão false: a referência do POST /v1/payments não marca
# payer.identification como obrigatório (o exemplo PHP do guia de Pix manda só o e-mail).
MP_REQUIRES_PAYER_CPF=false

# --- OAuth Mercado Pago por negócio (o Pix do sinal cai na conta do vendedor) ---
# O app precisa desta URL de redirecionamento, exatamente igual à cadastrada (https, sem query nem fragmento):
# https://www.agendapix.dev.br/api/integrations/mercadopago/callback
# Em local, use http://localhost:3000/api/integrations/mercadopago/callback.
# PKCE é opcional. Ligue só se o toggle "Usar o fluxo de código de autorização com o PKCE"
# existir e estiver habilitado, em Detalhes da aplicação → Editar dados → Configurações avançadas.
# on envia code_challenge (S256) e code_verifier. off (padrão) não envia esses campos.
# Espaços nas pontas são ignorados: " on " vale on, no boot e na conexão.
# Qualquer outro valor interrompe a conexão: MP_OAUTH_PKCE deve ser on ou off.
# Ausente vale off. Nunca deixe a variável vazia: string vazia derruba o boot (503 mp_oauth_pkce_invalid).
# Com MERCADOPAGO_ENV=production o boot exige MP_OAUTH_PKCE=on. Confirme isso em Production na Vercel antes do deploy.
# MP_OAUTH_PKCE=off
# Autorização padrão: https://auth.mercadopago.com/authorization. Sobrescreva só se precisar.
# MP_OAUTH_AUTHORIZE_URL=https://auth.mercadopago.com/authorization
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/mercadopago/callback
# openssl rand -hex 32 — chave só desta cifra. Nunca logue tokens.
MP_TOKEN_ENCRYPTION_KEY=

# --- Antiabuso das reservas públicas (backend, PRs #4 e #5) ---------------------
# Valores vazios usam o padrão indicado; valor inválido deixa o agendamento indisponível (503).
# Em produção: BOOKING_TRUST_PROXY=true atrás de um proxy que SOBRESCREVE X-Real-IP e o Next sem acesso direto.
BOOKING_TRUST_PROXY=false
# x-real-ip (padrão) ou x-forwarded-for (regra rightmost-trusted).
BOOKING_CLIENT_IP_HEADER=x-real-ip
# Quantos proxies confiáveis anexam X-Forwarded-For na frente do Next (1-10). Só com x-forwarded-for.
BOOKING_TRUSTED_PROXY_HOPS=1
# Tentativas por minuto: por cliente e teto total por negócio (teto >= cliente).
BOOKING_RATE_LIMIT_PER_CLIENT=10
BOOKING_RATE_LIMIT_PER_BUSINESS=120
# Consulta do status do Pix (a página pergunta a cada 4 s = 15/min). Balde separado da criação.
# Por cliente: 120 cabe a cadência, outra aba e o botão de verificar. Teto do negócio: 2400.
PAYMENT_POLL_RATE_LIMIT_PER_CLIENT=120
PAYMENT_POLL_RATE_LIMIT_PER_BUSINESS=2400
# Minutos que um horário fica reservado aguardando o Pix. Padrão 30. Faixa 28 a 43200.
# O Mercado Pago recebe hold + 2 min e exige pelo menos 30.
# Abaixo de 28 a resposta é 503 booking_unavailable (BOOKING_HOLD_MINUTES inválido).
BOOKING_HOLD_MINUTES=30
# Reservas pendentes (não pagas, não vencidas) simultâneas por negócio.
BOOKING_MAX_PENDING_PER_CLIENT=3
BOOKING_MAX_PENDING_PER_PHONE=2
BOOKING_MAX_PENDING_PER_BUSINESS=50
# Prazo do link de um horário, em minutos. Padrão 1440 (24 h). Faixa 15 a 10080.
# O link gravado nunca vence depois do início do horário: expiresAt = min(agora + prazo, startsAt).
SLOT_LINK_TTL_MINUTES=1440
# Links gerados por dono por minuto, aberturas e inícios de Pix do link.
SLOT_LINK_CREATE_PER_OWNER=30
SLOT_LINK_OPEN_PER_CLIENT=60
SLOT_LINK_OPEN_PER_BUSINESS=600
SLOT_LINK_PAY_PER_CLIENT=10
SLOT_LINK_PAY_PER_TOKEN=5
SLOT_LINK_PAY_PER_BUSINESS=120

# --- Cobrança Pix e reconciliação (backend, PR #7) ------------------------------
# Timeout das chamadas ao gateway (ms) ao criar/consultar/cancelar cobrança.
PAYMENT_PROVIDER_TIMEOUT_MS=8000
# Reconciliador (worker do compose / node reconcile.mjs): intervalo do loop, idade mínima de "creating" preso, lote.
RECONCILE_INTERVAL_SECONDS=60
RECONCILE_STUCK_SECONDS=60
RECONCILE_BATCH_SIZE=50
# Teto de uma passagem (ms). Padrão 50000, abaixo do maxDuration de 60s de /api/cron/reconcile.
# O worker contínuo pode subir até 300000. Abaixo de 1000 a config é rejeitada.
RECONCILE_BUDGET_MS=50000
# Sem servidor (Vercel): o worker em loop não existe; GET/POST /api/cron/reconcile faz uma passagem.
# Exige Authorization: Bearer <CRON_SECRET> (a Vercel Cron envia sozinha). Gere com: openssl rand -hex 32
CRON_SECRET=

# --- Servidor (imagem Docker / compose --profile app) ---------------------------
# Porta publicada em 127.0.0.1 pelo serviço "app" do compose.
APP_PORT=3000
# Dentro da imagem já valem NODE_ENV=production, PORT=3000 e HOSTNAME=0.0.0.0.
# MIGRATIONS_DIR=db/migrations   # opcional, usado por pnpm db:migrate e migrate.cjs

# Rotas internas /preview e a demo /exemplo. Fora de produção ficam abertas.
# Em produção respondem 404, a menos que este valor seja exatamente true.
PREVIEW_ROUTES_ENABLED=

# --- Assinatura manual do AgendaPix (BE-26) ------------------------------------
# Sem valor, ou com valor inválido, o checkout manual fica indisponível (available:false / 503)
# e o painel mostra "A assinatura está indisponível no momento".
# Com VERCEL_ENV=production, o next build (assertVercelProductionBuild) e o boot
# (assertProductionSafeEnv) falham se SUPPORT_WHATSAPP_NUMBER ou
# SUBSCRIPTION_MANUAL_ACTIVATION_HOURS faltarem ou forem inválidos. A mensagem cita
# o nome da variável, nunca o valor. Preview e dev não exigem as duas.
# O link público "Fale com a gente" usa o número e o e-mail de apoio do código quando estas envs faltam.
# O checkout da assinatura não usa esse número de apoio.
# WhatsApp do suporte: só dígitos, E.164 sem "+". Números só com zero ou de exemplo são rejeitados.
SUPPORT_WHATSAPP_NUMBER=
# E-mail de suporte. Vazio usa o e-mail de apoio do código. E-mail de exemplo é rejeitado.
SUPPORT_EMAIL=
# Inteiro >= 1, sem zero à esquerda. Prazo prometido na ativação manual, em horas. Não há cobrança automática.
SUBSCRIPTION_MANUAL_ACTIVATION_HOURS=1

# --- Logo do negócio (Vercel Blob) ---------------------------------------------
# Token de leitura e escrita do store público. O servidor chama put() com access public
# e addRandomSuffix. Sem este token, desenvolvimento e teste usam um adaptador falso
# (https://blob.fake.local). Em produção, a ausência responde 503 blob_unavailable.
# Não há fallback para o adaptador falso em produção.
# Crie a store ligada ao projeto, com acesso público, e cole o token aqui.
# https://vercel.com/docs/vercel-blob/using-blob-sdk#put
BLOB_READ_WRITE_TOKEN=

# O prefixo do link público NÃO é uma env nova:
# NEXT_PUBLIC_SITE_URL é a origem canônica (metadata, sitemap) via siteOrigin().
# BETTER_AUTH_URL é a origem absoluta no servidor (e-mail, WhatsApp, publicBusinessPageUrl).

# Não são mais necessárias com o app único (mesma origem para páginas e /api):
# NEXT_PUBLIC_BACKEND_URL, BACKEND_INTERNAL_URL, NEXT_PUBLIC_DASHBOARD_URL
