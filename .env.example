# Valores locais fictícios. Copie para .env e substitua antes de usar.
# Nunca commite o .env real. Em produção, configure estas variáveis no orquestrador (Coolify, etc.).

# --- Postgres (compose.yaml) ---------------------------------------------------
POSTGRES_DB=agenda
POSTGRES_USER=agenda
# Use só letras/números/-/_ ou percent-encode na DATABASE_URL.
POSTGRES_PASSWORD=local-example-change-me
# Porta publicada em 127.0.0.1 no host.
POSTGRES_PORT=5432

# --- Banco (lido pelo app, drizzle-kit, migrate.cjs e testes) -------------------
DATABASE_URL=postgresql://agenda:local-example-change-me@localhost:5432/agenda

# --- Autenticação (Better Auth) -------------------------------------------------
# URL pública do app (origem confiável dos links mágicos). Em produção: https://seu-dominio
BETTER_AUTH_URL=http://localhost:3000
# Gere um valor exclusivo: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-this-with-a-random-secret-at-least-32-characters

# --- Email (links de acesso por SMTP) -------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Usuário e senha devem ser configurados juntos (ou ambos vazios).
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Agenda <acesso@example.com>

# --- Pagamento ------------------------------------------------------------------
# fake (padrão fora de produção) | woovi. Em NODE_ENV=production o fake é recusado:
# configure PAYMENT_PROVIDER=woovi + WOOVI_AUTH_TOKEN + WOOVI_WEBHOOK_SECRET (senão a cobrança responde 503).
PAYMENT_PROVIDER=fake
FAKE_WEBHOOK_SECRET=replace-this-with-another-random-secret-at-least-32-characters

# Woovi/OpenPix (Pix real). A plataforma recebe o sinal; split para a chave Pix do negócio fica para a fase 2.
# AppID do painel Woovi (Aplicações → API), enviado no header Authorization. Nunca exponha no front.
WOOVI_AUTH_TOKEN=
# sandbox → https://api.woovi-sandbox.com | production → https://api.woovi.com
WOOVI_ENV=sandbox
# Opcional: sobrescreve a URL base (ex.: https://api.openpix.com.br). Vazio usa a de WOOVI_ENV.
WOOVI_BASE_URL=
# Secret do webhook (HMAC-SHA1 base64 do corpo bruto no header X-OpenPix-Signature), mín. 32 caracteres.
# Cadastre o webhook só para o evento OPENPIX:CHARGE_COMPLETED em /api/webhooks/payments/woovi.
WOOVI_WEBHOOK_SECRET=replace-this-with-the-woovi-webhook-secret-32-characters
# Opcional (recomendado): chave pública da Woovi (PEM ou PEM em base64) para exigir também x-webhook-signature (RSA-SHA256).
# Produção/sandbox publicam a chave em GET /api/v1/webhook/public-keys.
WOOVI_WEBHOOK_PUBLIC_KEY=

# --- Chave Pix (backend, PR #4) -------------------------------------------------
# Opcional para desenvolvimento. Gere com `openssl rand -hex 32` e configure por canal seguro.
# Sem este segredo, cadastro de chave Pix fica indisponível; nunca use uma chave compartilhada em produção.
PIX_KEY_ENCRYPTION_KEY=

# --- Antiabuso das reservas públicas (backend, PRs #4 e #5) ---------------------
# Valores vazios usam o padrão indicado; valor inválido deixa o agendamento indisponível (503).
# Em produção: BOOKING_TRUST_PROXY=true atrás de um proxy que SOBRESCREVE X-Real-IP e o Next sem acesso direto.
BOOKING_TRUST_PROXY=false
# x-real-ip (padrão) ou x-forwarded-for (regra rightmost-trusted).
BOOKING_CLIENT_IP_HEADER=x-real-ip
# Quantos proxies confiáveis anexam X-Forwarded-For na frente do Next (1-10). Só com x-forwarded-for.
BOOKING_TRUSTED_PROXY_HOPS=1
# Tentativas por minuto: por cliente e teto total por negócio (teto >= cliente).
BOOKING_RATE_LIMIT_PER_CLIENT=10
BOOKING_RATE_LIMIT_PER_BUSINESS=120
# Minutos que um horário fica reservado aguardando o Pix (2-30).
BOOKING_HOLD_MINUTES=10
# Reservas pendentes (não pagas, não vencidas) simultâneas por negócio.
BOOKING_MAX_PENDING_PER_CLIENT=3
BOOKING_MAX_PENDING_PER_PHONE=2
BOOKING_MAX_PENDING_PER_BUSINESS=50

# --- Cobrança Pix e reconciliação (backend, PR #7) ------------------------------
# Timeout das chamadas ao gateway (ms) ao criar/consultar/cancelar cobrança.
PAYMENT_PROVIDER_TIMEOUT_MS=8000
# Reconciliador (worker do compose / node reconcile.mjs): intervalo do loop, idade mínima de "creating" preso, lote.
RECONCILE_INTERVAL_SECONDS=60
RECONCILE_STUCK_SECONDS=60
RECONCILE_BATCH_SIZE=50

# --- Servidor (imagem Docker / compose --profile app) ---------------------------
# Porta publicada em 127.0.0.1 pelo serviço "app" do compose.
APP_PORT=3000
# Dentro da imagem já valem NODE_ENV=production, PORT=3000 e HOSTNAME=0.0.0.0.
# MIGRATIONS_DIR=db/migrations   # opcional, usado por pnpm db:migrate e migrate.cjs

# Não são mais necessárias com o app único (mesma origem para páginas e /api):
# NEXT_PUBLIC_BACKEND_URL, BACKEND_INTERNAL_URL, NEXT_PUBLIC_DASHBOARD_URL
