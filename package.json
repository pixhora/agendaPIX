{
  "name": "agenda-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "build": "next build",
    "db:up": "podman compose up -d --wait postgres",
    "db:down": "podman compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node --experimental-strip-types db/seed.mjs",
    "reconcile": "node --experimental-transform-types --import ./scripts/ts-register.mjs scripts/reconcile.ts",
    "build:bundles": "node scripts/bundle.mjs",
    "ci:local": "bash scripts/ci-local.sh",
    "db:migrate:prod": "node dist/migrate.cjs",
    "reconcile:prod": "node dist/reconcile.mjs",
    "pix:simulate": "node --env-file=.env scripts/simulate-pix.mjs",
    "billing:activate": "node --experimental-transform-types --import ./scripts/ts-register.mjs scripts/billing/activate-subscription.ts",
    "billing:requests": "node --experimental-transform-types --import ./scripts/ts-register.mjs scripts/billing/list-requests.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.2.3",
    "@vercel/blob": "^2.8.1",
    "@vercel/functions": "^3.9.11",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.14",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.25.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
